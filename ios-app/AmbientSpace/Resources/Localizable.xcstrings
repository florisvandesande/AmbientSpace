        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigt alleen AmbientSpace. Het iPhone-volume en andere apps blijven ongewijzigd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie uniquement AmbientSpace. Le volume de l’iPhone et des autres apps reste inchangé."
          }
