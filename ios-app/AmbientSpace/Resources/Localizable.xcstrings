    "AmbientSpace mixes with other apps and leaves their media controls available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace wird mit anderen Apps gemischt. Deren Mediensteuerung bleibt verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace mixes with other apps and leaves their media controls available."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace se mélange aux autres apps et laisse leurs commandes multimédias disponibles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace mengt met andere apps en laat hun mediabediening beschikbaar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace se mezcla con otras apps y mantiene disponibles sus controles multimedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace si combina con altre app e lascia disponibili i loro controlli multimediali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AmbientSpace mistura o áudio com outros apps e mantém os controles de mídia deles disponíveis."
          }
        }
      }
    },
    "AmbientSpace takes over media controls and shows the current cover." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace übernimmt die Mediensteuerung und zeigt das aktuelle Cover."
