        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace controla los controles multimedia y muestra la portada actual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace assume il controllo multimediale e mostra la copertina attuale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AmbientSpace assume os controles de mídia e mostra a capa atual."
