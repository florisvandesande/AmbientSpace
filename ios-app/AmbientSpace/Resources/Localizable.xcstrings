    "AmbientSpace mixes with other apps and leaves their media controls available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace wird mit anderen Apps gemischt. Deren Mediensteuerung bleibt verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AmbientSpace mixes with other apps and leaves their media controls available."
