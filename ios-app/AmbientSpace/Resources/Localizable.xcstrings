    "This recording is only %lld seconds long. Use at least twelve seconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording is only %lld seconds long. Use at least twelve seconds."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit audiobestand duurt slechts %lld seconden. Gebruik minimaal twaalf seconden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement ne dure que %lld secondes. Utilisez au moins douze secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme ist nur %lld Sekunden lang. Verwende mindestens zwölf Sekunden."
          }
        }
      }
    },
    "The recording could not be played. Check the audio file and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording could not be played. Check the audio file and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geluid kon niet worden afgespeeld. Controleer het audiobestand en probeer opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’enregistrement. Vérifiez le fichier audio et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht abgespielt werden. Prüfe die Audiodatei und versuche es erneut."
          }
        }
      }
    },
