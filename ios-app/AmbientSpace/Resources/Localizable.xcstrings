    "Only changes AmbientSpace. The iPhone volume and other apps stay unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only changes AmbientSpace. The iPhone volume and other apps stay unchanged."
