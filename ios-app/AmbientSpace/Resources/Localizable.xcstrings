    "Add a sound folder to audio-files and rebuild the app. The README in that folder explains each file step by step." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Klangordner zu audio-files hinzu und erstelle die App erneut. Die README in diesem Ordner erklärt jede Datei Schritt für Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a sound folder to audio-files and rebuild the app. The README in that folder explains each file step by step."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un dossier sonore dans audio-files, puis recompilez l’app. Le README de ce dossier explique chaque fichier pas à pas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een geluidsmap toe aan audio-files en bouw de app opnieuw. De README in die map beschrijft ieder bestand stap voor stap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una carpeta de sonido a audio-files y recompila la app. El README de esa carpeta explica cada archivo paso a paso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una cartella audio ad audio-files e ricompila l’app. Il README in quella cartella spiega ogni file passo per passo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma pasta de som a audio-files e recompile o app. O README dessa pasta explica cada arquivo passo a passo."
          }
        }
      }
    },
